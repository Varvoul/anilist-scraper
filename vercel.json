{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/v4/anime/:id(\\d+)/voice-actors", "destination": "/api/v4/anime/:id/characters" },
    { "source": "/v4/season/:season([a-z]+)/year/:year(\\d{4})", "destination": "/api/v4/seasons/:year/:season" },
    { "source": "/v4/season/:season([a-z]+)/:year(\\d{4})", "destination": "/api/v4/seasons/:year/:season" },
    { "source": "/v4/seasons/now", "destination": "/api/v4/seasons/current/current" },
    { "source": "/v4/studio/:name*", "destination": "/api/v4/studios/:name*" },
    { "source": "/v4/airing", "destination": "/api/v4/anime/airing" },
    { "source": "/v4/currently-airing", "destination": "/api/v4/anime/airing" },
    { "source": "/v4/popular", "destination": "/api/v4/anime/popular" },
    { "source": "/v4/:path*", "destination": "/api/v4/:path*" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type" }
      ]
    }
  ]
}
